-- waves.eod — background for reading. Nothing has an onset; that is the
-- entire design.
--
-- Stresses: continuous signals steering everything, envelopes measured in
-- seconds rather than milliseconds, very sparse reproducible randomness, and
-- a voice built from noise with no oscillator in it at all.

tempo(38)

---------------------------------------------------------------------- sends

deep = send { graph = reverb(64, 11.0, 0.35), level = 0.55 }

---------------------------------------------------------------------- rack

-- Surf: filtered pink noise, swelling on a period far longer than a bar.
surf = voice {
  params = { depth = { 0, 1, 1 } },
  graph = function(n)
    local swell = 0.5 - 0.5 * cosine(0.07)
    return (pink() | 300 + 900 * swell | dc(0.6)) >> lowpass()
        >> mul(swell * 0.35 * n.depth)
        >> (pan(-0.7) & pan(0.7))         -- two independent widths, mixed stereo
        >> chorus(1, 0.03, 0.02, 0.3)
  end,
}

-- Struck, not blown. Karplus-Strong excited by an impulse; the string is the
-- whole instrument.
glass = voice {
  params = { bright = { 0.1, 0.99, 0.86 } },
  graph = function(n)
    return impulse() >> pluck(n.hz, 0.5, n.bright)
        >> mul(n.velocity)
        >> (dc(n.hz * 2.7) | dc(140)) >> peak()      -- one formant, gently
        >> pan(rand(-0.4, 0.4))
        >> to(deep, 0.8)
  end,
}

drone = voice {
  graph = function(n)
    local osc = sine(n.hz)
              + sine(n.hz * 2.003) * 0.30
              + sine(n.hz * 3.010) * 0.12
    return osc * 0.25
        >> mul(adsr(secs(6), secs(2), 0.9, secs(8)))
        >> pan(rand(-0.4, 0.4))
  end,
}

---------------------------------------------------------------------- score

-- One breath every eight cycles, which at this tempo is about thirteen
-- seconds.
play(surf, "~ x" >> slow(8) >> surf.depth(scale(0.6, 1.0, perlin(0.01))))

play(drone, "<c2 [c2,g2] a#1 [f2,c3]>"
      >> slow(8)
      >> velocity(0.3))

-- Sparse and unrepeating, but reproducible: the same file always gives the
-- same nine minutes.
play(glass, "~ c5 ~ [~ g5] ~ ~ e5 ~"
      >> slow(2)
      >> degrade(0.6)
      >> velocity(scale(0.15, 0.40, perlin(0.03)))
      >> glass.bright(scale(0.7, 0.95, perlin(0.017))))

master(limiter(0.05, 1.2) >> mul(0.7))
