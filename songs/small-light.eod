-- small-light.eod — A Small Light Under Water
-- GPT-6 Astra, September 2026.
-- A little machine learning to sing. 96 BPM, forty bars, then silence.
-- Render: cargo run -p apteronotus-render -- songs/small-light.eod --cycles 40 --tail 7

tempo(96)

local water = send {
  graph = reverb(24, secs(2.8), 0.65),
  level = 0.32,
}

-- A rounded wooden strike, with an inharmonic edge that disappears first.
local wood = voice {
  graph = function(n)
    local body = sine(n.hz) * decay(ms(170))
    local edge = sine(n.hz * 2.73) * decay(ms(28)) * 0.24
    return (body + edge) * n.velocity * 0.17
      >> pan(n.pan) >> to(water, 0.17)
  end,
}

-- The bell's upper partial bends only while the hammer is still touching it.
local bell = voice {
  graph = function(n)
    local strike = sine(n.hz * 3.98 + decay(ms(45)) * 23)
      * decay(ms(210)) * 0.17
    local body = sine(n.hz) * decay(secs(1.5))
      + sine(n.hz * 2.002) * decay(ms(670)) * 0.28
    return (body + strike) * adsr(ms(4), ms(80), 0.85, secs(1.1))
      * n.velocity * 0.12 >> pan(n.pan) >> to(water, 0.65)
  end,
}

local breath = voice {
  graph = function(n)
    local drift = init_random(1, 0.998, 1.002)
    local body = soft_saw(n.hz * drift) + sine(n.hz * 0.5) * 0.25
    return body >> lowpass(1050 + decay(secs(1.4)) * 750, 0.65)
      >> mul(adsr(ms(280), ms(600), 0.65, secs(1.7)) * n.velocity * 0.065)
      >> pan(n.pan) >> to(water, 0.45)
  end,
}

local bass = voice {
  graph = function(n)
    return (sine(n.hz) + sine(n.hz * 2) * 0.14)
      * adsr(ms(12), ms(180), 0.7, ms(180)) * n.velocity * 0.12
      >> pan(0)
  end,
}

local heart = voice {
  graph = function(n)
    return sine(47 + decay(ms(32)) * 68) * decay(ms(180))
      * n.velocity * 0.23 >> pan(0)
  end,
}

local sand = voice {
  graph = function(n)
    return noise() >> highpass(3600, 0.6)
      >> mul(decay(ms(34)) * n.velocity * 0.032)
      >> pan(n.pan) >> to(water, 0.2)
  end,
}

-- D minor with its window open: the B natural arrives with the fuller middle.
-- Each row is two bars. The bass changes the meaning of the common tones.
local chords = {
  "[f3,a3,c4,e4]", "[e3,g3,a3,d4]",
  "[f3,a3,c4,d4]", "[e3,g3,c4,d4]",
}
local roots = { "d2", "c2", "bb1", "c2" }
local open_chords = {
  "[f3,a3,b3,e4]", "[e3,g3,b3,d4]",
  "[e3,a3,c4,d4]", "[f3,a3,c4,e4]",
}
local open_roots = { "d2", "g2", "a1", "d2" }
local tune = {
  "~ a4 ~ ~ e5 ~ d5 ~", "~ ~ c5 ~ a4 ~ ~ ~",
  "~ g4 ~ a4 ~ ~ e4 ~", "d4 ~ ~ ~ ~ ~ ~ ~",
  "~ a4 ~ c5 e5 ~ ~ d5", "~ c5 ~ ~ a4 ~ g4 ~",
  "e4 ~ ~ g4 ~ a4 ~ ~", "~ ~ d5 ~ ~ ~ ~ ~",
}
local answer = {
  "~ e5 ~ ~ b4 ~ a4 ~", "g4 ~ ~ ~ d5 ~ ~ ~",
  "~ a4 ~ b4 ~ e5 ~ ~", "d5 ~ ~ ~ c5 ~ a4 ~",
  "~ ~ e5 ~ a5 ~ e5 ~", "d5 ~ b4 ~ ~ g4 ~ ~",
  "~ e5 ~ d5 c5 ~ a4 ~", "~ ~ ~ e5 d5 ~ ~ ~",
}

local wooden, bells, pads, lows, kicks, grains = {}, {}, {}, {}, {}, {}
for bar = 0, 39 do
  local row = math.floor(bar / 2) % 4 + 1
  local middle = bar >= 16 and bar < 32
  local root = roots[row]
  local harmony = chords[row]
  if middle then root = open_roots[row]; harmony = open_chords[row] end
  if bar >= 36 then root = "d2"; harmony = "[f3,a3,c4,e4]" end

  -- 3 + 3 + 2 is the gait; every fourth bar leaves out its final footstep.
  if bar < 36 then
    local cell = "d4 ~ ~ a3 ~ ~ e4 ~"
    if bar % 4 == 3 then cell = "d4 ~ ~ a3 ~ ~ ~ ~" end
    if middle then cell = "d4 ~ a3 ~ ~ e4 a3 ~" end
    local strength = 0.62
    if bar >= 32 then strength = 0.38 end
    table.insert(wooden, at(bars(bar), pattern(cell)
      >> velocity(strength) >> pan(-0.3)))
  end

  if bar >= 4 and bar < 38 then
    table.insert(pads, at(bars(bar), pattern(harmony)
      >> hold(bars(0.88)) >> velocity(0.72)
      >> pan(0.24)))
    local line = root .. " ~ ~ ~ ~ " .. root .. " ~ ~"
    if bar < 8 or bar >= 32 then line = root .. " ~ ~ ~" end
    table.insert(lows, at(bars(bar), pattern(line)
      >> hold(beats(1.3)) >> velocity(0.76)))
  end

  if bar >= 8 and bar < 32 then
    local melody = tune[(bar - 8) % 8 + 1]
    if middle then melody = answer[(bar - 16) % 8 + 1] end
    table.insert(bells, at(bars(bar), pattern(melody)
      >> hold(beats(0.8)) >> velocity(0.72) >> pan(0.18)))
    local beat = "x ~ ~ ~ x ~ ~ ~"
    if bar % 4 == 3 then beat = "x ~ ~ ~ ~ ~ x ~" end
    table.insert(kicks, at(bars(bar), pattern(beat) >> velocity(0.68)))
    table.insert(grains, at(bars(bar), pattern("~ ~ x ~ ~ x ~ x")
      >> velocity(0.55) >> pan(-0.48)))
  end
end

-- The melody returns as fragments; the unresolved ninth is the last light.
table.insert(bells, at(bars(33), pattern("a4 ~ ~ e5 ~ ~ d5 ~")
  >> hold(beats(1)) >> velocity(0.55) >> pan(0.1)))
table.insert(bells, at(bars(35), pattern("~ c5 ~ ~ a4 ~ ~ ~")
  >> hold(beats(1)) >> velocity(0.46) >> pan(-0.1)))
table.insert(bells, at(bars(38), pattern("e5 ~ ~ ~")
  >> hold(beats(2)) >> velocity(0.38) >> pan(0.2)))

play(wood, timeline(wooden))
play(bell, timeline(bells))
play(breath, timeline(pads))
play(bass, timeline(lows))
play(heart, timeline(kicks))
play(sand, timeline(grains))
master(limiter(ms(4), ms(160)) >> mul(0.88))
