  {{"g4",1},{"f#4",0.5},{"e4",0.5},{"d4",1}}, -- 14
  {{"d#4",0.5},{"f#4",0.5},{"a4",0.5},{"g4",0.5},{"f#4",0.5},{"d#4",0.5}}, -- 15
  {{"e4",2},{"~",1}}, -- 16
  {{"g4",0.5},{"bb4",0.5},{"a4",0.5},{"eb5",0.5},{"d5",0.5},{"c5",0.5}}, -- 17
  {{"bb4",1},{"a4",0.5},{"g4",0.5},{"f4",1}}, -- 18
