-- nightshift-dub.eod — the rain reaches the basement
-- A dub variation of nightshift: E minor, 108 BPM, a thirty-two-bar version.
-- The original's held harmony becomes offbeat organ chops; bass answers the
-- empty beats and a filtered dotted-quarter echo supplies the counterline.
-- Render: cargo run -p apteronotus-render -- --song nightshift-dub --cycles 32 --tail 6

tempo(108)
local echo = send {
  graph = delay(beats(1.5)) >> lowpass(2100) >> feedback(0.48) >> highpass(280),
  level = 0.32,
}
local room = send {
  graph = reverb(28, secs(2.4), 0.7) >> highpass(220) >> lowpass(3400),
  level = 0.20,
}
local bass_level = control { name = "bass", range = {0, 1.5}, default = 1 }
local chords_level = control { name = "chops", range = {0, 1.5}, default = 1 }
local drums_level = control { name = "drums", range = {0, 1.5}, default = 1 }

local organ = voice {
  params = { tone = {400, 3200, 1500, "hz"} },
  graph = function(n)
    local body = sine(n.hz) * 0.65 + sine(n.hz * 2) * 0.24
      + pulse(n.hz, 0.34) * 0.13
    return body >> lowpass(n.tone, 0.65)
      >> mul(adsr(ms(6), ms(130), 0.18, ms(95)) * n.velocity * 0.23 * chords_level)
      >> pan(n.pan)
  end,
}
local bass = voice {
  graph = function(n)
    local body = sine(n.hz) + soft_saw(n.hz) * 0.22
    return body >> lowpass(420 + decay(ms(130)) * 380, 0.6)
      >> mul(adsr(ms(10), ms(190), 0.68, ms(100)) * n.velocity * 0.34 * bass_level)
      >> shape("tanh", 1.2) >> dcblock() >> pan(0)
  end,
}
local kick = voice {
  graph = function(n)
    return sine(49 + decay(ms(30)) * 62) * decay(ms(160))
      * (1 - decay(ms(2))) * n.velocity * 0.48 * drums_level >> pan(0)
  end,
}
local rim = voice {
  graph = function(n)
    local wood = sine(830) * decay(ms(20)) + sine(1370) * decay(ms(12)) * 0.4
    local skin = (noise() >> bandpass(1900, 1.3)) * decay(ms(28)) * 0.3
    return (wood + skin) * n.velocity * 0.23 * drums_level >> pan(-0.14)
  end,
}
local hat = voice {
  graph = function(n)
    return noise() >> bandpass(4900, 0.8)
      >> mul(decay(ms(38)) * (1 - decay(ms(2))) * n.velocity * 0.11 * drums_level)
      >> pan(n.pan)
  end,
}
local drop = voice {
  graph = function(n)
    return sine(n.hz * (1 + decay(ms(75)) * 0.9)) * decay(ms(220))
      * (1 - decay(ms(3))) * n.velocity * 0.15 >> pan(n.pan)
  end,
}

-- The same i–VI–III–VII colours as nightshift, now above a syncopated bass.
-- Building each bar explicitly lets the fourth section remove actual onsets.
local harmonies = {"[e3,g3,b3,d4]", "[c3,e3,g3,b3]", "[g3,b3,d4,e4]", "[d3,f#3,a3,c4]"}
local roots = {"e2", "c2", "g1", "d2"}
local fifths = {"b1", "g1", "d2", "a1"}
local chops, lows, kicks, rims, hats, drops = {}, {}, {}, {}, {}, {}
for bar = 0, 31 do
  local chord = math.floor(bar / 2) % 4 + 1
  local sparse = (bar >= 12 and bar < 16) or bar >= 28
  local h, r, f = harmonies[chord], roots[chord], fifths[chord]
  local chop = "~ " .. h .. " ~ " .. h .. " ~ " .. h .. " ~ " .. h
  if bar % 4 == 3 or sparse then chop = "~ " .. h .. " ~ ~ ~ ~ ~ ~" end
  table.insert(chops, at(bars(bar), pattern(chop) >> hold(beats(0.23))
    >> velocity(0.72) >> organ.tone(1250 + (bar % 3) * 240)
    >> pan(-0.22)))
  local low = r .. " ~ ~ " .. r .. " ~ " .. f .. " " .. r .. " ~"
  if sparse then low = r .. " ~ ~ ~ ~ ~ " .. f .. " ~" end
  table.insert(lows, at(bars(bar), pattern(low) >> hold(beats(0.72)) >> velocity(0.8)))
  if not sparse or bar % 2 == 0 then
    table.insert(kicks, at(bars(bar), pattern("~ ~ x ~ ~ ~ x ~") >> velocity(0.8)))
    table.insert(rims, at(bars(bar), pattern("~ ~ x ~ ~ ~ x ~")
      >> velocity(0.66)))
  end
  if not sparse then
    table.insert(hats, at(bars(bar), pattern("x ~ x x ~ x x ~")
      >> velocity("0.48 0.3 0.62 0.35") >> pan("0.3 -0.25")))
  end
  if bar % 4 == 3 then
    table.insert(drops, at(bars(bar), pattern("~ ~ ~ b3")
      >> velocity(0.55) >> pan(0.36)))
  end
end
-- Twelve bars of bass and chops return after the four-bar echo breakdown;
-- the final four bars strip the kit away and leave the room to decay.
play(organ, timeline(chops) >> to(echo, 0.65) >> to(room, 0.25))
play(bass, timeline(lows))
play(kick, timeline(kicks))
play(rim, timeline(rims) >> to(echo, 0.34))
play(hat, timeline(hats))
play(drop, timeline(drops) >> to(echo, 0.85))
master(highpass(32) >> lowpass(7600, 0.65) >> limiter(ms(5), ms(180)) >> mul(0.94))
