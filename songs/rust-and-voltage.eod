-- rust-and-voltage.eod — Rust and Voltage
-- GPT-6 Astra. Dirty revision: torn-speaker riffs; no recordings or samples.
-- 128 BPM / 64 bars / two minutes, plus the amplifier-room tail.
-- Intro 0–4, riff 4–16, chorus 16–24, riff 24–32, chorus 32–40,
-- half-time breakdown 40–48, solo 48–56, last chorus 56–62, stop 62–64.
-- Render: cargo run -p apteronotus-render -- songs/rust-and-voltage.eod --cycles 64 --tail 4

tempo(128)

local room = send {
  graph = reverb(11, secs(0.65), 0.58),
  level = 0.19,
}

-- A plucked attack plus two band-limited saws supply the string spectrum.
-- A falling low-pass sheds upper partials without a bank of sine oscillators.
-- All strings hit the SAME nonlinear amplifier.
-- Asymmetric preamp saturation, a second clipping stage, then the cabinet.
-- Longer string decay feeds the saturated amp between attacks. Riff gates
-- overlap; short ring settings are reserved for the palm-muted breakdown.
local function amplifier(side, detune)
  return voice {
    params = { ring = { 0.08, 8, 2.8, "s" } },
    graph = function(n)
      local hz = n.hz * detune * init_random(1, 0.997, 1.003)
        * (1 + decay(ms(45)) * 0.007)
      local pick = noise() * decay(ms(9))
      local string_attack = pick * 2 >> pluck(n.hz, 0.06, 0.25)
      local body = saw(hz) * 0.52 + saw(hz * 1.4983) * 0.38
      local strings = (body >> lowpass(1400 + decay(secs(0.9)) * 4200, 0.65))
        + string_attack * 0.8
      local scrape = pick >> highpass(1700, 0.7) >> mul(0.22)
      local dry = (strings * decay(n.ring) + scrape) * n.velocity
      return (dry >> highpass(75, 0.7)) + 0.09
        >> shape("tanh", 18) >> dcblock()
        >> lowpass(6200, 0.65) >> shape("clip", 2.1)
        >> lowpass(3700, 0.8) >> highpass(70, 0.7)
        >> mul(adsr(ms(1), ms(35), 0.95, ms(140)) * 0.22)
        >> pan(side) >> to(room, 0.09)
    end,
  }
end
local left = amplifier(-0.76, 0.9985)
local right = amplifier(0.76, 1.0015)

local bass = voice {
  graph = function(n)
    local body = sine(n.hz) * 0.8 + saw(n.hz) * 0.25
    return body >> shape("tanh", 1.8) >> lowpass(1000, 0.65)
      >> dcblock()
      >> mul(adsr(ms(3), ms(100), 0.72, ms(55)) * n.velocity * 0.12)
      >> pan(0)
  end,
}

local kick = voice {
  graph = function(n)
    local skin = (sine(57 + decay(ms(12)) * 35)
      + sine(113) * 0.2) * decay(ms(210))
    local beater = noise() >> bandpass(2200, 0.8)
      >> mul(decay(ms(5)) * 0.18)
    return (skin + beater * 1.8) >> shape("tanh", 1.4)
      >> mul(n.velocity * 0.3) >> pan(0)
  end,
}
local snare = voice {
  graph = function(n)
    local skin = (sine(178 + decay(ms(16)) * 45)
      + sine(331) * 0.38) * decay(ms(85))
    local wires = noise() >> highpass(1300, 0.6) >> lowpass(7600, 0.6)
      >> mul(decay(ms(110)) * 1.3)
    return (skin * 0.9 + wires) >> shape("tanh", 2.8)
      >> mul(n.velocity * 0.34) >> pan(-0.08) >> to(room, 0.6)
  end,
}
local hat = voice {
  graph = function(n)
    return noise() >> highpass(5300, 0.65) >> lowpass(11500, 0.6)
      >> mul(decay(ms(80)) * n.velocity * 0.11)
      >> pan(0.38) >> to(room, 0.1)
  end,
}
local crash = voice {
  graph = function(n)
    local metal = sine(3431) * sine(5173) + sine(6287) * sine(8111)
    return (noise() * 0.8 + metal * 0.22)
      >> highpass(2400, 0.6) >> lowpass(11000, 0.6)
      >> mul(decay(secs(1.5)) * n.velocity * 0.21)
      >> pan(-0.42) >> to(room, 0.5)
  end,
}
local tom = voice {
  graph = function(n)
    return (sine(n.hz + decay(ms(28)) * 38)
      + sine(n.hz * 1.61) * 0.24) * decay(ms(170))
      * n.velocity * 0.3 >> pan(n.pan) >> to(room, 0.32)
  end,
}
local lead = voice {
  graph = function(n)
    local bend = 1 - decay(ms(38)) * 0.022
    local hz = n.hz * bend * (1 + sine(5.6) * 0.003)
    return (saw(hz) + sine(hz * 2) * 0.18)
      >> shape("tanh", 2.8) >> lowpass(2600, 0.7)
      >> mul(adsr(ms(6), ms(140), 0.7, ms(110)) * n.velocity * 0.18)
      >> pan(0.08) >> to(room, 0.65)
  end,
}

local guitars_l, guitars_r, low, bd, sd, hh, cym, toms, solo =
  {}, {}, {}, {}, {}, {}, {}, {}, {}
-- Keep patterns, rather than strings, so riff-table tokens retain editor spans.
local riffs = {
  pattern("e2 e2 ~ [e2 e2] g2 ~ a2 g2"),
  pattern("e2 ~ e2 e2 bb2 a2 g2 ~"),
  pattern("e2 e2 ~ [e2 e2] f2 ~ e2 ~"),
  pattern("g2 a2 bb2 a2 g2 ~ e2 ~"),
}
local bass_riffs = {
  pattern("e1 e1 ~ [e1 e1] g1 ~ a1 g1"),
  pattern("e1 ~ e1 e1 bb1 a1 g1 ~"),
  pattern("e1 e1 ~ [e1 e1] f1 ~ e1 ~"),
  pattern("g1 a1 bb1 a1 g1 ~ e1 ~"),
}
local chorus = { pattern("c3 c3"), pattern("g2 g2"), pattern("d3 d3"), pattern("a2 a2") }
local chorus_bass = {
  pattern("c2 c2 c2 c2 c2 c2 c2 c2"), pattern("g1 g1 g1 g1 g1 g1 g1 g1"),
  pattern("d2 d2 d2 d2 d2 d2 d2 d2"), pattern("a1 a1 a1 a1 a1 a1 a1 a1"),
}
local solo_notes = {
  pattern("e4 ~ g4 a4 b4 ~ a4 g4"), pattern("e4 ~ ~ g4 a4 ~ d5 ~"),
  pattern("b4 a4 g4 ~ e4 g4 a4 ~"), pattern("b4 ~ ~ ~ ~ ~ d5 ~"),
  pattern("e5 ~ d5 b4 a4 ~ g4 a4"), pattern("b4 d5 e5 ~ g5 ~ e5 d5"),
  pattern("b4 ~ a4 g4 e4 ~ d4 ~"), pattern("e4 ~ ~ ~ ~ ~ ~ ~"),
}
local function put(lane, bar, notes, level)
  table.insert(lane, at(bars(bar), notes >> velocity(level)))
end

for bar = 0, 61 do
  local row = bar % 4 + 1
  local refrain = (bar >= 16 and bar < 24) or (bar >= 32 and bar < 40)
    or bar >= 56
  local breakdown = bar >= 40 and bar < 48
  local notes, bassline = riffs[row], bass_riffs[row]
  local ringtime, gate = 2.8, 0.65
  if refrain then
    notes, bassline = chorus[row], chorus_bass[row]
    ringtime, gate = 6.5, 2.15
  elseif breakdown then
    notes, bassline = pattern("[e2 e2] ~ ~ e2 ~ ~ f2 ~"), pattern("[e1 e1] ~ ~ e1 ~ ~ f1 ~")
    ringtime, gate = 0.24, 0.3
    if row == 4 then
      notes, bassline = pattern("a2 ~ ~ ~ g2 ~ d3 ~"), pattern("a1 ~ ~ ~ g1 ~ d2 ~")
    end
  end
  table.insert(guitars_l, at(bars(bar), notes
    >> hold(beats(gate)) >> left.ring(ringtime)
    >> velocity(pattern("0.95 0.76 0.86 0.72 0.98 0.78 0.9 0.82"))))
  if bar >= 2 then
    -- A second take wanders by a few milliseconds from bar to bar.
    table.insert(guitars_r, at(secs(bar * 1.875 + 0.004 + (bar % 3) * 0.003), notes
      >> hold(beats(gate * 0.94)) >> right.ring(ringtime * 1.09)
      >> velocity(pattern("0.87 0.82 0.75 0.9 0.91 0.72 0.83 0.95"))))
  end
  if bar >= 4 then
    table.insert(low, at(bars(bar), bassline
      >> hold(beats(0.44)) >> velocity(0.85)))
    local kicks = pattern("x ~ ~ x ~ ~ x ~")
    local snares = pattern("~ ~ x ~ ~ ~ x ~")
    if refrain then kicks = pattern("x ~ x ~ x x ~ ~") end
    if breakdown then
      kicks, snares = pattern("x ~ ~ ~ ~ ~ x ~"), pattern("~ ~ ~ ~ x ~ ~ ~")
    end
    if bar % 8 == 7 then
      snares = pattern("~ ~ x ~ ~ x [x x] ~")
      put(toms, bar, pattern("~ ~ ~ ~ ~ ~ a2 e2"), 0.8)
    end
    put(bd, bar, kicks, 0.9)
    table.insert(sd, at(secs(bar * 1.875 + 0.009 + (bar % 3) * 0.002),
      snares >> velocity(0.8 + (bar % 4) * 0.035)))
    local hats = pattern("x x x x x x x x")
    if breakdown then hats = pattern("x ~ x ~ x ~ x ~") end
    table.insert(hh, at(bars(bar), hats
      >> velocity(pattern("0.85 0.42 0.65 0.46 0.8 0.4 0.64 0.5"))))
  end
  if bar == 4 or bar == 16 or bar == 24 or bar == 32 or bar == 40
    or bar == 48 or bar == 56 or bar == 60 then
    put(cym, bar, pattern("x ~ ~ ~"), 0.85)
  end
  if bar >= 48 and bar < 56 then
    table.insert(solo, at(bars(bar), solo_notes[bar - 47]
      >> hold(beats(0.62)) >> velocity(0.82)))
  end
end

-- A two-beat unison hit, a breath, then one final open E.
for _, hit in ipairs({ 62, 63 }) do
  local final_gate = 1.5
  if hit == 63 then final_gate = 3.7 end
  table.insert(guitars_l, at(bars(hit), pattern("e2 ~")
    >> hold(beats(final_gate)) >> left.ring(6.5) >> velocity(0.9)))
  table.insert(guitars_r, at(bars(hit), pattern("e2 ~")
    >> hold(beats(final_gate)) >> right.ring(6.5) >> velocity(0.85)))
  table.insert(low, at(bars(hit), pattern("e1 ~")
    >> hold(beats(1.5)) >> velocity(0.9)))
  put(bd, hit, pattern("x ~ ~ ~"), 0.95)
  put(sd, hit, pattern("x ~ ~ ~"), 0.85)
  put(cym, hit, pattern("x ~ ~ ~"), 0.9)
end

play(left, timeline(guitars_l))
play(right, timeline(guitars_r))
play(bass, timeline(low))
play(kick, timeline(bd))
play(snare, timeline(sd))
play(hat, timeline(hh))
play(crash, timeline(cym))
play(tom, timeline(toms))
play(lead, timeline(solo))
master(limiter(ms(3), ms(90)) >> mul(0.9))
