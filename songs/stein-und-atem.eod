-- stein-und-atem.eod — Stein und Atem (Stone and Breath)
-- Original organ prelude after the Frankfurt church recording, not its tune.
-- 32 measures of 3/4, quarter=78: 73.846 seconds, then 8 seconds of room.
-- 1–8 invocation; 9–16 answering voices; 17–24 chromatic side chapel;
-- 25–32 return, a descending pedal and a quiet E-major resolution.
-- Sample-free registration informed by IMG_9443.mov. These generic ranks are
-- an approximation, not measured Klais stops. Room time is a design choice:
-- the 11-second recording contains no isolated decay for measuring RT60.
-- Written pedal E2–E3; its 16-foot stop sounds one octave below.
-- No key-velocity response, tremolo, chorus, distortion or hidden limiter.
-- Render: cargo run --release -p apteronotus-render -- --song stein-und-atem --cycles 24 --tail 8 -o target/frankfurt-organ/stein-und-atem.wav

tempo(78)
local expression=control {name="Organ expression",range={0,1},default=.85}
local upper=control {name="Upper ranks",range={0,1},default=.65}
local hall=send {
  graph=reverb(38,secs(3.8),.66) >> highpass(75) >> lowpass(7200),
  level=.85,
}

-- Fixed rank positions and small tuning offsets: an ensemble of pipes,
-- rather than a new randomly detuned ensemble on every key press.
local function frankfurt_manual(hz,brightness)
  local top=slew(upper,.025)*brightness
  local ranks={
    {"principal",8,.34,-1.8,-.7},
    {"principal",8,.30,1.8,.7},
    {"flute",8,.23,-1.1,.18},
    {"string",8,.12,1.4,.45},
    {"principal",4,.80*top,.7,.55},
    {"principal",2,.85*top,-.8,-.55},
    {"principal",8/3,.13*top,1.0,.25},
    {"principal",4/3,.22*top,-1.2,-.4},
    {"principal",1,.13*top,1.3,.4},
    {"reed",8,.24,-.5,-.18},
  }
  local sum=dc(0) >> pan(0)
  for _,r in ipairs(ranks) do
    local pipe=organ_pipe(hz,{kind=r[1],feet=r[2],level=r[3],cents=r[4],chiff=.005})
    sum=sum+(pipe >> pan(r[5]))
  end
  return sum
end
local singing=voice {graph=function(n)
  return frankfurt_manual(n.hz,1)*.16*slew(expression,.025)
end}
local answering=voice {graph=function(n)
  return frankfurt_manual(n.hz,.65)*.16*slew(expression,.025)
end}
local foundation=voice {graph=function(n)
  return organ(n.hz,{
    {kind="flute",feet=16,level=.65,chiff=0},
    {kind="principal",feet=8,level=.32,chiff=.003},
    {kind="principal",feet=4,level=.06,chiff=0},
  })*.16*slew(expression,.025) >> pan(-.02)
end}

-- Each row is one 3/4 measure of {pitch, quarter-note duration} events.
-- Gates follow those written durations; half notes sustain through the moving
-- eighth-note line. All score construction happens once during evaluation.
local soprano={
  {{"e4",0.5},{"g4",0.5},{"f#4",0.5},{"b4",0.5},{"a4",0.5},{"g4",0.5}}, -- 1
  {{"f#4",1},{"e4",0.5},{"d#4",0.5},{"b3",1}}, -- 2
  {{"e4",1},{"b4",0.5},{"a4",0.5},{"g4",0.5},{"f#4",0.5}}, -- 3
  {{"g4",1.5},{"f#4",0.5},{"e4",1}}, -- 4
  {{"a4",0.5},{"c5",0.5},{"b4",0.5},{"a4",0.5},{"g4",0.5},{"f#4",0.5}}, -- 5
  {{"g4",1},{"f#4",0.5},{"e4",0.5},{"d4",1}}, -- 6
  {{"f#4",0.5},{"a4",0.5},{"g4",0.5},{"f#4",0.5},{"e4",0.5},{"d#4",0.5}}, -- 7
  {{"e4",2.5},{"~",0.5}}, -- 8
  {{"b4",0.5},{"d5",0.5},{"c5",0.5},{"e5",0.5},{"d5",0.5},{"c5",0.5}}, -- 9
  {{"b4",1},{"a4",0.5},{"g4",0.5},{"f#4",1}}, -- 10
