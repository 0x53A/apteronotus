-- nightshift.eod — the office is quiet enough to hear the rain.
--
-- Traditional synthwave for work rather than for a chase scene. The tempo is
-- walking pace, the backbeat is straight, and every recognisable sound comes
-- from the usual small analogue vocabulary: saws, pulses, sine, noise, a dark
-- ladder filter, chorus, plate and tape delay.
--
-- "Not busy" is a rate and register decision here, not a synonym for empty.
-- The bass supplies the pulse below middle C. The keys never play more than
-- two notes in a bar, and the lead never moves faster than quarter notes or
-- above B4. Interest comes instead from two related eight-bar progressions, a
-- five-bar keys phrase moving through them, and a returning 32-bar form that
-- periodically leaves the harmony almost alone.

tempo(92)
key("e", "minor")

---------------------------------------------------------------------- space

-- Long enough to join held chords, dark enough not to turn the hats into a
-- ceiling. The high-pass keeps bass fundamentals out of the return.
room = send {
  graph = reverb(42, secs(3.8), 0.68)
       >> highpass(180)
       >> lowpass(4200),
  level = 0.25,
}

-- A quarter-note echo rather than the genre's busier dotted eighth. Its top
-- has gone by 2.2 kHz, so the repeat sits behind the note that caused it.
tape = send {
  graph = delay(beats(1))
       >> lowpass(2200)
       >> feedback(0.32),
  level = 0.16,
}

---------------------------------------------------------------------- desk

lvl_pad   = control { name = "pad",   range = { 0, 1.5 }, default = 1 }
lvl_bass  = control { name = "bass",  range = { 0, 1.5 }, default = 1 }
lvl_keys  = control { name = "keys",  range = { 0, 1.5 }, default = 1 }
lvl_lead  = control { name = "lead",  range = { 0, 1.5 }, default = 1 }
lvl_drums = control { name = "drums", range = { 0, 1.5 }, default = 1 }

---------------------------------------------------------------------- rack

-- A Juno-shaped pad: three quiet oscillators into one gently moving low-pass,
-- followed by chorus. The attack is long enough that chord changes overlap
-- rather than announce themselves.
pad = voice {
  params = {
    cutoff = { 250, 4200, 1350, "hz" },
    spread = { 0, 0.018, 0.005 },
  },
  graph = function(n)
    local osc = soft_saw(n.hz * (1 - n.spread)) * 0.28
              + soft_saw(n.hz) * 0.34
              + soft_saw(n.hz * (1 + n.spread)) * 0.28
              + pulse(n.hz * 0.5, 0.38) * 0.12
    local breathe = 0.86 + 0.14 * sine(0.08)
    return (osc | n.cutoff * breathe | dc(0.58)) >> lowpass()
        >> highpass(95)
        >> mul(adsr(secs(1.35), secs(1.2), 0.76, secs(3.0))
               * n.velocity * 0.42 * lvl_pad)
        >> chorus(1, 0.021, 0.007, 0.28)
        >> pan(n.pan)
  end,
}

-- The pulse lives down here. Four rounded quarter notes per bar read as
-- motion without putting a fast line in the listener's foreground.
bass = voice {
  params = { cutoff = { 100, 1800, 620, "hz" } },
  graph = function(n)
    local env = adsr(ms(18), ms(240), 0.34, ms(150))
    local osc = sine(n.hz) * 0.55
              + saw(n.hz) * 0.32
              + pulse(n.hz * 2, 0.42) * 0.16
    return (osc | n.cutoff * (0.82 + 0.75 * env) | dc(0.34)) >> moog()
        >> mul(env * n.velocity * 0.62 * lvl_bass)
        >> shape("tanh", 1.35)
        >> dcblock()
        >> pan(0)
  end,
}

-- A soft electric-keyboard pluck. There is enough tine to separate it from
-- the pad, but the attack is rounded and the brightest partial is gone in
-- 140 ms. The score gives it only one or two notes per bar.
keys = voice {
  params = { tone = { 600, 4200, 1900, "hz" } },
  graph = function(n)
    local body = sine(n.hz) * decay(secs(1.7))
               + sine(n.hz * 2.01) * decay(ms(780)) * 0.24
    local tine = sine(n.hz * 4.03)
               * decay(ms(140)) * (1 - decay(ms(12))) * 0.13
    local onset = 1 - decay(ms(14))
    return (body + tine) * onset
        >> (dc(n.tone) | dc(0.55)) >> lowpass()
        >> mul(n.velocity * 0.34 * lvl_keys)
        >> shape("soft", 1.08)
        >> pan(n.pan)
  end,
}

-- The lead is an occasional second voice, not a permanent narrator. A slow
-- attack and delayed vibrato make its few long notes feel played rather than
-- sequenced; the score keeps it at B4 or below.
lead = voice {
  params = { cutoff = { 700, 5200, 2300, "hz" } },
  graph = function(n)
    local vibrato = 1 + 0.0038 * sine(4.8) * window(secs(0.55), secs(8))
    local hz = n.hz * vibrato
    local osc = soft_saw(hz) * 0.48
              + pulse(hz * 0.5, 0.44) * 0.24
              + sine(hz) * 0.34
    local env = adsr(ms(170), secs(0.75), 0.64, secs(1.8))
    return (osc | n.cutoff * (0.88 + 0.42 * env) | dc(0.38)) >> lowpass()
        >> mul(env * n.velocity * 0.65 * lvl_lead)
        >> chorus(0, 0.024, 0.008, 0.18)
        >> pan(n.pan)
  end,
}

-- A softened Linn-shaped kit: an audible kick, a compact gated snare and
-- offbeat hats whose band-pass deliberately stops the noise becoming white.
kick = voice {
  graph = function(n)
    local pitch = 48 + 52 * decay(ms(42))
    local body = (pitch >> sine()) * decay(ms(165)) * (1 - decay(ms(3)))
    local tap = ((noise() | dc(1350) | dc(1.0)) >> bandpass())
              * decay(ms(8)) * 0.08
    return (body + tap)
        >> mul(n.velocity * 0.74 * lvl_drums)
        >> shape("tanh", 1.35)
        >> dcblock()
        >> pan(0)
  end,
}

snare = voice {
  graph = function(n)
    local noise_body = (noise() | dc(1550) | dc(0.9)) >> bandpass()
    local skin = sine(185) * 0.32 + sine(292) * 0.16
    local hit = (noise_body + skin) * decay(ms(82)) * (1 - decay(ms(3)))
    local plate = hit >> reverb(24, secs(1.45), 0.56)
    return (hit * 0.72 + plate * window(0, ms(180)) * 0.48)
        >> mul(n.velocity * 1.18 * lvl_drums)
  end,
}

hat = voice {
  params = { tone = { 1800, 9000, 4300, "hz" } },
  graph = function(n)
    local env = decay(ms(62)) * (1 - decay(ms(3)))
    return (noise() | dc(n.tone) | dc(0.75)) >> bandpass()
        >> mul(env * n.velocity * 1.10 * lvl_drums)
        >> pan(n.pan)
  end,
}

-- One low tom at the ends of selected sections is enough to make the form
-- turn a corner. It never becomes a fill competing with the melody.
tom = voice {
  graph = function(n)
    local pitch = n.hz * (1 + 0.72 * decay(ms(70)))
    local body = (pitch >> sine()) * decay(ms(310)) * (1 - decay(ms(4)))
    return body
        >> mul(n.velocity * 0.55 * lvl_drums)
        >> shape("tanh", 1.18)
        >> dcblock()
        >> pan(n.pan)
  end,
}

---------------------------------------------------------------------- harmony

-- Sixteen bars: a familiar i–VI–III–VII opening, then the same colours turn
-- inward through VI–VII–i–v. Common tones in the upper voices make the change
-- feel like lighting rather than a new scene.
chords = pattern("<[e2,b2,d3,f#3] [c2,g2,b2,e3] [g2,d3,e3,b3] [d2,a2,e3,f#3] [c2,g2,b2,e3] [d2,a2,b2,f#3] [e2,b2,d3,g3] [b1,f#2,a2,d3]>")
      >> slow(2)

-- One bar of quarter-note pulse per written row. The octave is an accent, not
-- a high line; the last slot often points gently toward the next chord.
roots = pattern([[<
  [e1 ~ e2 ~ e1 ~ b1 ~ e1 ~ e2 ~ b1 ~ d2 ~]
  [c2 ~ c2 ~ g1 ~ b1 ~ c2 ~ e2 ~ g1 ~ b1 ~]
  [g1 ~ g1 ~ d2 ~ e2 ~ g1 ~ d2 ~ e2 ~ b1 ~]
  [d2 ~ d2 ~ a1 ~ d2 ~ d2 ~ a1 ~ e2 ~ f#2 ~]
  [c2 ~ c2 ~ g1 ~ b1 ~ c2 ~ e2 ~ g1 ~ b1 ~]
  [d2 ~ d2 ~ a1 ~ b1 ~ d2 ~ f#2 ~ e2 ~ a1 ~]
  [e1 ~ e2 ~ b1 ~ d2 ~ e1 ~ e2 ~ g1 ~ b1 ~]
  [b1 ~ b1 ~ f#1 ~ a1 ~ b1 ~ d2 ~ f#1 ~ a1 ~]
>]]) >> slow(2)

-- Five bars against the sixteen-bar harmony. Every pitch belongs to E minor
-- pentatonic, so changing alignments create sixths, ninths and suspensions but
-- never a semitone that asks to be resolved while somebody is reading.
keys_phrase = pattern([[<
  [~ b3 ~ e4]
  [g4 ~ ~ b3]
  [~ d4 ~ a3]
  [e4 ~ b3 ~]
  [~ g4 ~ d4]
>]])

-- A complete sixteen-bar melody, heard only in a few four-bar sections below.
-- Rests occupy more slots than notes, and the contour returns downward after
-- every B4 so the upper edge never becomes the centre of gravity.
melody = pattern([[<
  [~ b4 ~ g4]
  [e4 ~ f#4 ~]
  [~ g4 ~ e4]
  [d4 ~ ~ ~]
  [~ b4 ~ a4]
  [g4 ~ e4 ~]
  [f#4 ~ ~ e4]
  [d4 ~ ~ ~]
  [~ e4 ~ g4]
  [b4 ~ a4 ~]
  [~ f#4 ~ e4]
  [d4 ~ ~ ~]
  [~ g4 ~ b4]
  [a4 ~ g4 ~]
  [f#4 ~ e4 ~]
  [d4 ~ ~ ~]
>]])

---------------------------------------------------------------------- form

-- Eight four-bar rooms make a 32-bar form. Because these are cyclic patterns
-- rather than finite curves, the song can stay on through a long study block:
-- intro, rhythm, first melody, interlude, breakdown, rebuild, second melody,
-- full return. The pad never leaves; everything else gets real empty space.
local function sections(spec)
  return pattern(spec) >> slow(32)
end

pad_sections   = sections("0.72 0.88 1 0.82 0.68 0.88 1 1")
bass_sections  = sections("0 0.62 0.82 0.74 0 0.62 0.82 0.88")
kick_sections  = sections("0 0.55 0.72 0.62 0 0.48 0.72 0.76")
snare_sections = sections("0 0.42 0.64 0.56 0 0.40 0.64 0.68")
hat_sections   = sections("0 0.30 0.56 0.40 0 0.24 0.52 0.48")
keys_sections  = sections("0.58 0.72 0.42 0.65 0.72 0.62 0.34 0.42")
lead_sections  = sections("0 0 0.56 0 0 0 0.42 0.62")
tom_sections   = sections("0 0 0.35 0 0 0 0.22 0.40")

-- Parameter motion uses long periods which divide neither the 16-bar harmony
-- nor the 32-bar form. It is felt over minutes but never turns into a sweep.
warmth = scale(1120, 1750, sine(1 / 11))
motion = scale(0.004, 0.007, sine(1 / 13))
weight = scale(0.93, 1.0, sine(1 / 17))

---------------------------------------------------------------------- score

play(pad, chords
      >> velocity(0.58 * weight * pad_sections)
      >> pad.cutoff(warmth)
      >> pad.spread(motion)
      >> pan("-0.28 0.28")
      >> to(room, 0.58)
      >> duck("1 0 1 0", 0.12))

play(bass, roots
      >> velocity(0.72 * weight * bass_sections)
      >> bass.cutoff(scale(500, 760, sine(1 / 11)))
      >> duck("1 0 1 0", 0.18))

play(keys, keys_phrase
      >> shift(bars(1))
      >> velocity(0.56 * weight * keys_sections)
      >> keys.tone(scale(1550, 2250, sine(1 / 13)))
      >> pan("-0.22 0.20 -0.10 0.24")
      >> to(tape, 0.30)
      >> to(room, 0.42))

play(lead, melody
      >> velocity(0.60 * weight * lead_sections)
      >> lead.cutoff(scale(2100, 3200, sine(1 / 13)))
      >> pan(scale(-0.16, 0.16, sine(1 / 11)))
      >> to(tape, 0.22)
      >> to(room, 0.62))

-- The kit is intentionally ordinary. The only variation is a quiet pickup in
-- the fourth bar; novelty here would compete with the long-form variation.
play(kick, pattern("<[bd ~ bd ~] [bd ~ bd ~] [bd ~ bd ~] [bd ~ bd [~ bd]]>")
      >> velocity(0.82 * weight * kick_sections))

play(snare, pattern("<[~ x ~ x] [~ x ~ x] [~ x ~ x] [~ x ~ [~ x]]>")
      >> velocity(0.72 * snare_sections)
      >> to(room, 0.22))

-- Four offbeat eighths per bar are the fastest layer in the piece. At 92 BPM
-- and 4.3 kHz they provide air, not a treble melody.
play(hat, "~ x ~ x ~ x ~ x"
      >> velocity(scale(0.28, 0.44, sine(2)) * hat_sections)
      >> hat.tone(scale(3600, 4800, sine(1 / 13)))
      >> pan("-0.24 0.25"))

play(tom, pattern("<~ ~ [~ ~ ~ b2] ~ ~ ~ [~ ~ e2 ~] [~ ~ ~ b2]>")
      >> velocity(0.52 * tom_sections)
      >> pan("0.18 -0.16")
      >> to(room, 0.32))

-- Warm, wide and conservative at the edge. The limiter is protection rather
-- than an audible pump, and the 8.5 kHz ceiling is part of the arrangement.
master(
    highpass(38)
    >> width(2.35)
    >> lowpass(8500, 0.6)
    >> shape("soft", 1.04)
    >> limiter(0.012, 0.42)
    >> mul(1.38)
)
