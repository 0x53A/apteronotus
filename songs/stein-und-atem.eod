local function part(instrument,rows,wet)
  if #rows~=32 then error("prelude needs 32 measures") end
  local notes={}
  for bar,row in ipairs(rows) do
    local offset=0
    for _,event in ipairs(row) do
      local pitch,quarters=event[1],event[2]
      if pitch~="~" then
        table.insert(notes,at(beats((bar-1)*3+offset),
          pattern(pitch) >> hold(beats(quarters*.94)),beats(.25)))
      end
      offset=offset+quarters
    end
    if offset~=3 then error("measure must contain three quarters") end
  end
  play(instrument,timeline(notes) >> to(hall,wet))
end
part(singing,soprano,.85)
part(answering,alto,.85)
part(answering,tenor,.85)
part(foundation,pedal,.65)
