-- neon.eod — eighty storeys of weather and one light left on.
--
-- An original, through-composed neon-noir cue. No samples and no wavetable
-- instruments: every sound begins as a saw, pulse, sine, noise, or impulse.
--
-- Stresses what the first four songs do not:
--
--   * a finite timeline and a tempo map rather than an endlessly cycling form;
--   * extended chords, anchors, voicings, and root extraction;
--   * a dual-layer CS-80-shaped voice built from raw subtractive components;
--   * curve-valued pressure and bend parameters that remain live after onset;
--   * a persistent monophonic patch for phase-continuous ribbon leads;
--   * deterministic component drift per allocated voice;
--   * optional live audio and control inputs composed by ordinary dataflow;
--   * a hall assembled from delay, diffusion, feedback, damping, and modulation.
--
-- New score vocabulary proposed here:
--
--   tempo { ... }               a finite transport tempo map
--   timeline { at(t, pattern) } finite, non-repeating placement
--   hold(duration)              the gate/whole duration of an event
--   phase(x)                    note-clock sugar; requires a finite hold
--   Value::Curve                a normal parameter value, carried unsampled
--   *_input { name, default }   logical sources; the shell binds hardware
--   run(patch, span)            keep one persistent graph alive over a span
--
-- The composition lasts 72 bars, but the lead deliberately enters in absolute
-- seconds. Musical time and wall time are different clocks and remain visible.

key("d", "dorian")

tempo {
  { at = bars(0),  bpm = 42 },
  { at = bars(12), bpm = 46, over = bars(4) },
  { at = bars(32), bpm = 51, over = bars(8) },
  { at = bars(56), bpm = 44, over = bars(8) },
  { at = bars(68), bpm = 38, over = bars(4) },
}

sections = {
  rain      = span(bars(0),  bars(72)),
  glass     = span(bars(8),  bars(30)),
  city      = span(bars(12), bars(64)),
  ribbon    = span(bars(18), bars(61)),
  afterglow = span(bars(56), bars(72)),
}

-- These declarations produce typed external nodes. Device identity stays in
-- the host: "expression" may be MIDI, a potentiometer, or a GUI control.
-- Missing input uses the declared fallback and reports a non-fatal diagnostic.
city_air = audio_input {
  name = "city_air",
  channels = 1,
  fallback = "silence",
}

expression_input = control_input {
  name = "expression",
  range = { 0, 1 },
  default = 0.58,
}

-- There is no global mapping table. The input is visibly transformed where it
-- is consumed, using the same signal algebra as authored automation.
lead_expression = scale(0.72, 1.18, expression_input) >> slew(ms(24))

---------------------------------------------------------------------- helpers

-- The CS-80 filter envelope is IL–AL–A–D–R, not an ADSR. Both filter cutoffs
-- move from an initial offset to an attack overshoot, settle, then release.
-- This is a note-clock curve; gate may be a symbolic note duration.
local function cs_filter_envelope(gate)
  return curve {
    { secs(0),          -0.18 },
    { ms(140),           1.00 },
    { secs(1.25),        0.24 },
    { gate,              0.18 },
    { gate + secs(2.4), -0.18 },
  }
end

-- One of the two complete synth channels in a CS-80-shaped voice. This is a
-- Lua construction helper: it expands once per edit into ordinary graph data.
local function cs_channel(n, tune, pulse_mix, brightness)
  local voice_drift = init_rand(n.id, "oscillator", -n.drift, n.drift)
  local filter_drift = init_rand(n.id, "filter", 0.97, 1.03)
  local hz = n.hz * semitones(n.bend) * tune * (1 + voice_drift)

  local slow_pwm = 0.07 * sine(0.13 + init_rand(n.id, "pwm", -0.01, 0.01))
  local delayed_vibrato = 0.0035 * sine(5.15) * window(secs(0.7), n.duration)

  local source =
      saw(hz * (1 + delayed_vibrato)) * (1 - pulse_mix)
    + pulse(hz * (1 + delayed_vibrato), 0.38 + slow_pwm) * pulse_mix
    + noise() * 0.006

  local filter_motion = cs_filter_envelope(n.duration)
  local pressure_open = exp2(2.4 * n.pressure)
  local cutoff = brightness * filter_drift * pressure_open
               * (1 + 2.8 * filter_motion)

  -- The unusual series pair is a large part of the voice: resonant high-pass,
  -- then resonant low-pass, both following the same filter envelope.
  local high = (source | dc(72) | dc(0.22)) >> highpass()
  return (high | cutoff | dc(n.resonance)) >> lowpass()
end

-- A note with a written performance. Curves are ordinary ControlMap values:
-- the onset query carries each curve whole into the patch rather than sampling
-- it to a scalar. `phase` is legal here because `hold` makes duration known;
-- a live note instead uses absolute note-clock curves and an explicit gate.
local function performed_note(start, duration, pitch, pressure_amount, bend_amount)
  return at(start,
    note(pitch)
      >> hold(duration)
      >> ribbon_lead.pressure(curve {
           { phase(0.00), 0.12 },
           { phase(0.18), pressure_amount },
           { phase(0.68), pressure_amount * 0.82 },
           { phase(1.00), 0.08 },
         })
      >> ribbon_lead.bend(curve {
           { phase(0.00), -0.08 },
           { phase(0.10),  0.00 },
           { phase(0.72),  bend_amount },
           { phase(1.00),  0.00 },
         })
      >> ribbon_lead.expression(lead_expression))
end

local function held_chord(start, duration, symbol, anchor_note, shape, pressure_amount, pressure_setter)
  return at(start,
    chord(symbol)
      >> anchor(anchor_note)
      >> voicing(shape)
      >> hold(duration)
      >> pressure_setter(curve {
           { phase(0.00), 0.08 },
           { phase(0.24), pressure_amount },
           { phase(0.72), pressure_amount * 0.76 },
           { phase(1.00), 0.05 },
         }))
end

---------------------------------------------------------------------- rack

neon_pad = voice {
  params = {
    brightness = { 180, 10000, 1450, "hz" },
    resonance  = { 0, 1, 0.34 },
    drift      = { 0, 0.02, 0.0045 },
    pressure   = { 0, 1, 0.22 },
    bend       = { -12, 12, 0, "st" },
  },

  graph = function(n)
    local dark  = cs_channel(n, 0.997, 0.28, n.brightness * 0.82)
    local light = cs_channel(n, 1.003, 0.52, n.brightness * 1.14)
    local body  = dark * 0.52 + light * 0.48
    local amp   = adsr(secs(1.1), secs(1.8), 0.78, secs(3.8))
                * scale(0.42, 1.0, n.pressure)

    return body
        >> mul(amp * n.velocity)
        >> shape("soft", 1.12)
        >> chorus(0, 0.021, 0.007, 0.36)
        >> pan(n.pan)
  end,
}

-- One graph for the whole lead. Pitch, gate, pressure, bend, and expression
-- remain writable control ports; oscillator and filter state survive notes.
ribbon_lead = patch {
  controls = {
    pitch      = note_control("d4"),
    gate       = gate_control(false),
    pressure   = control { range = { 0, 1 }, default = 0.18 },
    bend       = control { range = { -24, 24 }, default = 0, unit = "st" },
    expression = control { range = { 0, 1.2 }, default = 0.58 },
    brightness = control { range = { 180, 12000 }, default = 2100, unit = "hz" },
  },

  graph = function(c)
    local hz = note_hz(c.pitch + c.bend)
    local vibrato = sine(5.05) * (0.001 + 0.004 * c.pressure)
    local source = saw(hz * (1 + vibrato)) * 0.62
                 + pulse(hz * 0.999, 0.41) * 0.38

    local cutoff = c.brightness * exp2(2.7 * c.pressure)
    local high = (source | dc(95) | dc(0.18)) >> highpass()
    local tone = (high | cutoff | dc(0.46)) >> lowpass()
    local amp = gate_env(c.gate, ms(35), secs(1.4), 0.86, secs(2.8))
              * scale(0.32, 1.0, c.pressure)
              * c.expression

    return tone
        >> mul(amp)
        >> ringmod(sine(0.31), 0.035)
        >> shape("soft", 1.08)
        >> pan(0.08)
  end,
}

-- Synthetic "human voice": raw pulse and breath noise into fixed vowel
-- formants, then a three-line ensemble. No recordings are involved.
breath_choir = voice {
  params = {
    vowel    = { 0, 1, 0.42 },
    air      = { 0, 0.2, 0.045 },
    pressure = { 0, 1, 0.24 },
  },

  graph = function(n)
    local source = pulse(n.hz, 0.48) * 0.18
                 + pulse(n.hz * 2.001, 0.51) * 0.07
                 + pink() * n.air

    local low_vowel = ((source | dc(610)  | dc(5.5)) >> bandpass()) * 0.55
                    + ((source | dc(1080) | dc(7.0)) >> bandpass()) * 0.30
                    + ((source | dc(2450) | dc(9.0)) >> bandpass()) * 0.15

    local high_vowel = ((source | dc(780)  | dc(5.0)) >> bandpass()) * 0.48
                     + ((source | dc(1450) | dc(7.5)) >> bandpass()) * 0.34
                     + ((source | dc(2750) | dc(10.0)) >> bandpass()) * 0.18

    return mix(low_vowel, high_vowel, n.vowel)
        >> mul(adsr(secs(2.8), secs(1.5), 0.88, secs(5.2))
               * n.velocity * scale(0.55, 1.0, n.pressure))
        >> ensemble {
             delays = { ms(13), ms(19), ms(27) },
             rates  = { 0.47, 0.71, 0.93 },
             depth  = ms(2.4),
           }
        >> pan(n.pan)
  end,
}

-- A modeled electric piano: an impulse excites a deterministic inharmonic
-- resonator bank. The short noise burst is the hammer, not a sample.
glass_keys = voice {
  params = {
    tine = { 0.1, 6.0, 2.4, "s" },
  },

  graph = function(n)
    local ratios = { 1.0, 2.01, 3.97, 6.12, 9.05 }
    local modes = {}
    for i, ratio in ipairs(ratios) do
      modes[i] = ring(n.hz * ratio, n.tine / (0.65 + 0.42 * i))
               * (1 / (i * i))
    end

    local strike = impulse() + noise() * decay(ms(2.2)) * 0.06
    return strike
        >> mix(modes)
        >> mul(decay(n.tine) * n.velocity * 0.7)
        >> shape("soft", 1.18)
        >> tremolo(4.7, 0.12)
        >> pan(n.pan)
  end,
}

-- Continuous weather. An optional microphone or line input is filtered and
-- folded into the synthetic layer. With no binding, city_air is silence.
rain_field = patch {
  graph = function(_)
    local swell = 0.50 - 0.50 * cosine(0.031)
    local synthetic = (pink() | 180 + 1600 * swell | dc(0.48)) >> lowpass()
    local city = city_air >> highpass(90) >> lowpass(6200)

    return synthetic * (0.08 + 0.13 * swell)
         + city * 0.16
        >> (pan(-0.82) & pan(0.82))
        >> chorus(1, 0.034, 0.012, 0.18)
  end,
}

low_current = voice {
  params = {
    pressure = { 0, 1, 0.22 },
  },
  graph = function(n)
    local source = sine(n.hz) + pulse(n.hz, 0.46) * 0.16
    local motion = 0.78 + 0.22 * sine(0.09)
    return (source | dc(420 * motion) | dc(0.22)) >> lowpass()
        >> mul(adsr(ms(18), secs(1.2), 0.72, secs(2.6))
               * n.velocity * scale(0.62, 1.0, n.pressure))
        >> shape("soft", 1.2)
        >> pan(0)
  end,
}

-- One distant structural groan: impulse into modes, entirely synthesized.
tower = voice {
  graph = function(n)
    local modes = {
      ring(n.hz,        secs(5.8)) * 0.62,
      ring(n.hz * 1.47, secs(4.1)) * 0.24,
      ring(n.hz * 2.76, secs(2.7)) * 0.11,
      ring(n.hz * 5.08, secs(1.9)) * 0.05,
    }
    return impulse()
        >> mix(modes)
        >> shape("tanh", 1.7)
        >> dcblock()
        >> pan(n.pan)
  end,
}

---------------------------------------------------------------------- space

-- `diffuse` and `fdn` are stdlib graph constructors. They expand to delay
-- lines, allpasses, a Hadamard feedback matrix, damping filters, and slow
-- modulation. Delay storage and interpolation are the stateful primitives.
neon_hall = send {
  params = {
    decay = { 1, 18, 8.6, "s" },
  },

  graph = delay(ms(71))
       >> diffuse {
            delays = { ms(4.7), ms(6.8), ms(10.1), ms(13.7) },
            gains  = { 0.71, -0.69, 0.67, -0.65 },
          }
       >> fdn {
            delays = { ms(43.7), ms(47.9), ms(53.3), ms(59.9),
                       ms(67.1), ms(71.9), ms(79.7), ms(89.3) },
            matrix = "hadamard",
            decay = param("decay"),
            damping = 0.46,
            modulation = { rate = 0.11, depth = ms(1.7) },
          }
       >> highpass(85)
       >> mul(0.82),

  level = 0.48,
}

echoes = send {
  graph = delay(ms(438))
       >> feedback(0.38)
       >> lowpass(2800)
       >> shape("soft", 1.05),
  level = 0.18,
}

---------------------------------------------------------------------- harmony

-- Original modal harmony, deliberately not a transcription. Literal calls to
-- chord/anchor/voicing expand at construction time; the resulting pitches and
-- grouped chord identity survive into the finite timeline.
pad_score = timeline {
  held_chord(bars(0),  bars(6), "Dm(add9)",       "d3", "open-5", 0.42, neon_pad.pressure),
  held_chord(bars(6),  bars(6), "Cmaj9/E",        "e3", "wide-5", 0.36, neon_pad.pressure),
  held_chord(bars(12), bars(5), "G6(add9)",       "d3", "open-6", 0.48, neon_pad.pressure),
  held_chord(bars(17), bars(3), "A7sus4(b9)",     "e3", "wide-5", 0.62, neon_pad.pressure),
  held_chord(bars(20), bars(7), "Dm6/9",          "a3", "open-6", 0.56, neon_pad.pressure),
  held_chord(bars(27), bars(5), "Bbmaj7(#11)/D",  "d3", "wide-6", 0.51, neon_pad.pressure),
  held_chord(bars(32), bars(6), "Em11",           "b3", "open-5", 0.58, neon_pad.pressure),
  held_chord(bars(38), bars(4), "Gm(maj9)/D",     "d3", "wide-5", 0.68, neon_pad.pressure),
  held_chord(bars(42), bars(6), "Dm(add9)/A",     "a3", "open-6", 0.61, neon_pad.pressure),
  held_chord(bars(48), bars(4), "Cmaj9(#11)",     "g3", "wide-6", 0.54, neon_pad.pressure),
  held_chord(bars(52), bars(4), "A7sus4(b9)",     "e3", "open-5", 0.72, neon_pad.pressure),
  held_chord(bars(56), bars(7), "Dm6/9",          "d3", "wide-6", 0.52, neon_pad.pressure),
  held_chord(bars(63), bars(5), "G6(add9)/D",     "d3", "open-6", 0.38, neon_pad.pressure),
  held_chord(bars(68), bars(4), "Dm(add9)",       "d3", "close-5", 0.24, neon_pad.pressure),
}

choir_score = timeline {
  held_chord(bars(12), bars(8), "G6(add9)",      "g4", "close-4", 0.34, breath_choir.pressure),
  held_chord(bars(20), bars(7), "Dm6/9",         "a4", "close-5", 0.42, breath_choir.pressure),
  held_chord(bars(32), bars(10), "Em11",         "b4", "close-5", 0.48, breath_choir.pressure),
  held_chord(bars(42), bars(10), "Dm(add9)/A",   "a4", "close-5", 0.55, breath_choir.pressure),
  held_chord(bars(52), bars(11), "A7sus4(b9)",   "e4", "close-5", 0.62, breath_choir.pressure),
  held_chord(bars(63), bars(9), "Dm(add9)",      "a4", "close-5", 0.28, breath_choir.pressure),
}

-- Root extraction is a typed music operation, not string slicing in Lua.
bass_score = pad_score
          >> root_notes()
          >> octave(-2)
          >> velocity(0.46)

keys_score = timeline {
  at(bars(8) + beats(1.4),
    chord("Dm(add9)") >> anchor("d4") >> voicing("drop-2")
      >> arp("outside-in", beats(0.72)) >> velocity(0.34)),

  at(bars(15) + beats(2.1),
    chord("G6(add9)") >> anchor("g4") >> voicing("open-5")
      >> arp("down", beats(0.81)) >> velocity(0.27)),

  at(bars(29) + beats(0.6),
    chord("Bbmaj7(#11)") >> anchor("f4") >> voicing("drop-2")
      >> arp("inside-out", beats(0.67)) >> velocity(0.36)),

  at(bars(46) + beats(2.7),
    chord("Cmaj9(#11)") >> anchor("g4") >> voicing("open-5")
      >> arp("up", beats(0.74)) >> velocity(0.31)),

  at(bars(65) + beats(1.2),
    chord("Dm6/9") >> anchor("a4") >> voicing("close-5")
      >> arp("down", beats(0.96)) >> velocity(0.22)),
}

---------------------------------------------------------------------- ribbon

-- Absolute seconds make the lack of a grid intentional rather than simulated
-- with an extremely slow cycle. These pitches form an original melody.
lead_score = timeline {
  performed_note(secs(55.8),  secs(4.7), "a4",  0.56,  0.18),
  performed_note(secs(62.1),  secs(7.9), "d5",  0.72, -0.24),
  performed_note(secs(72.6),  secs(3.8), "c5",  0.46,  0.11),
  performed_note(secs(78.4),  secs(8.2), "e5",  0.78,  0.36),

  performed_note(secs(94.9),  secs(6.4), "f5",  0.63, -0.17),
  performed_note(secs(103.2), secs(4.1), "e5",  0.54,  0.08),
  performed_note(secs(110.0), secs(9.6), "b4",  0.81,  0.48),

  performed_note(secs(130.7), secs(5.3), "d5",  0.58, -0.12),
  performed_note(secs(138.8), secs(7.6), "g5",  0.84,  0.62),
  performed_note(secs(149.1), secs(3.9), "f5",  0.49, -0.10),
  performed_note(secs(155.6), secs(8.8), "e5",  0.74,  0.29),

  performed_note(secs(177.4), secs(6.2), "c5",  0.60, -0.18),
  performed_note(secs(186.0), secs(9.4), "a4",  0.76,  0.52),
  performed_note(secs(199.1), secs(4.8), "e5",  0.51,  0.09),
  performed_note(secs(206.8), secs(11.7), "d5", 0.82, -0.31),

  performed_note(secs(231.6), secs(7.8), "a4",  0.48,  0.16),
  performed_note(secs(242.0), secs(13.5), "d5", 0.67, -0.22),
}

---------------------------------------------------------------------- score

run(rain_field, sections.rain)

play(neon_pad, pad_score
      >> neon_pad.brightness(1420)
      >> neon_pad.resonance(0.34)
      >> neon_pad.drift(0.0045)
      >> velocity(0.36)
      >> pan("-0.24 0.22")
      >> to(neon_hall, 0.72))

play(breath_choir, choir_score
      >> breath_choir.vowel(line(0.28, 0.68, bars(44)) >> shift(bars(12)))
      >> breath_choir.air(0.052)
      >> velocity(0.27)
      >> pan("0.28 -0.30")
      >> to(neon_hall, 0.84))

play(low_current, bass_score
      >> to(neon_hall, 0.22))

play(glass_keys, keys_score
      >> glass_keys.tine("2.8 2.2 3.6 2.5 4.2")
      >> pan("-0.38 0.31")
      >> to(echoes, 0.44)
      >> to(neon_hall, 0.52))

play(ribbon_lead, lead_score
      >> ribbon_lead.brightness(2050)
      >> to(echoes, 0.24)
      >> to(neon_hall, 0.78))

play(tower, timeline {
      at(bars(12), note("d1") >> hold(secs(7.0)) >> velocity(0.50) >> pan(-0.18)),
      at(bars(40), note("a0") >> hold(secs(8.5)) >> velocity(0.62) >> pan(0.21)),
      at(bars(56), note("d1") >> hold(secs(10))  >> velocity(0.44) >> pan(-0.08)),
    }
    >> to(neon_hall, 0.88))

master(
    highpass(24)
    >> shape("soft", 1.04)
    >> limiter(0.012, 0.48)
    >> mul(0.82)
)
