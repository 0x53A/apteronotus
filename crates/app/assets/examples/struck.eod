-- Percussion with no oscillators and no samples.
--
-- The impulse response of a resonant second-order section is
-- e^(-zeta*w0*t) * sin(wd*t) — a decaying sinusoid, which is what a struck bar
-- sounds like. So a drum kit is pole placement: pick a frequency and a decay
-- time and the damping follows.
--
-- `ring(hz, decay)` is a stdlib composition rather than a primitive; it is
-- multiplication and a band-pass, with the bandwidth solved from the decay you
-- asked for.

local cowbell = voice {
  graph = function(n)
    return impulse()
        >> (ring(587, secs(0.18)) + ring(845, secs(0.15)) * 0.7)
        >> shape("tanh", 1.3)
        >> dcblock()
        >> mul(n.velocity * 0.5)
        >> pan(n.pan)
  end,
}

local rim = voice {
  graph = function(n)
    return impulse()
        >> ring(1700, ms(28))
        >> mul(n.velocity * 0.6)
        >> dcblock()
        >> pan(-0.3)
  end,
}

play(cowbell, "c4 ~ c4 c4")
play(rim, "~ c4 ~ c4")
