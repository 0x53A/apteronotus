-- organ-laboratory.eod — Pipes Under Pressure
-- Dry comparison, 30 seconds. Same A1/A3/E5 figures, roughly level matched.
-- 0–6s classic additive flute; 6–12s revised additive speech;
-- 12–18s experimental physical flue. Each section has three two-second slots.
-- 18–30s ONE retained physical pipe: pressure .70→.95; a 40 ms valve closure;
-- reopening at .85; a one-second closure; reopening; final wind shutdown at 27s.
-- No reverb, distortion or limiter: listen to the pipe behavior itself.
-- Render: cargo run -p apteronotus-render -- --song organ-laboratory --seconds 30 --tail 1
-- Physical frequencies are nominal: pressure affects tuning and tone. This
-- prototype is an open flue approximation, not a model of our stopped flute.
tempo(120)
local classic = voice { graph=function(n)
  return organ_pipe(n.hz, {kind="flute", chiff=0, voicing="classic"}) * .40 >> pan(0)
end }
local speech = voice { graph=function(n)
  return organ_pipe(n.hz, {kind="flute", chiff=0}) * .40 >> pan(0)
end }
local physical = voice { graph=function(n)
  local wind = adsr(ms(20), ms(1), 1, ms(35)) * .85
  return flue_pipe(n.hz, wind, noise(), {min_hz=40}) * .80 >> pan(0)
end }
local pitches = {"a1", "a3", "e5"}
for i, instrument in ipairs({classic, speech, physical}) do
  local notes = {}
  for j, pitch in ipairs(pitches) do
    table.insert(notes, at(secs((i - 1) * 6 + (j - 1) * 2),
      pattern(pitch) >> hold(beats(3.2))))
  end
  play(instrument, timeline(notes))
end

local scale = control {name="Wind scale", range={0,1}, default=1}
local pressure = pattern("0@900 .70@100 .95@100 0@2 .85@98 0@50 .85@100 0@150") >> slow(15)
local retained = patch { graph=function()
  return flue_pipe(110, control_signal(pressure, bars(15)) * scale, noise(), {min_hz=40})
    * .65 >> pan(0)
end }
run(retained)
