-- poles.eod — a whole drum kit with no oscillators and no samples.
--
-- Every voice here is an impulse fired into a resonant second-order section.
-- Its impulse response is e^(-zeta*w0*t) * sin(wd*t) — a decaying sinusoid,
-- which is what a struck bar sounds like. So the design surface is pole
-- placement: choose a frequency and a decay time, and the damping follows.
--
-- `ring(hz, t60)` is stdlib, not a primitive: it solves the resonator's
-- bandwidth from the decay you asked for, using the settling-time relation
-- t_se ~ 3 / (zeta * w0).
--
-- Stresses: delta at audio rate, the stdlib-vs-primitive split, and voices
-- whose entire parameter set is two numbers.

tempo(96)

---------------------------------------------------------------------- sends

room = send { graph = reverb(18, 1.4, 0.5), level = 0.3 }

---------------------------------------------------------------------- rack

cowbell = voice {
  params = { ring = { 0.02, 2.0, 0.18, "s" } },
  graph = function(n)
    return impulse()
        >> (ring(587, n.ring) + ring(845, n.ring * 0.85) * 0.7)
        >> shape("tanh", 1.3)
        >> dcblock() >> pan(n.pan) >> to(room, 0.35)
  end,
}

rim = voice {
  graph = function(n)
    return impulse() >> ring(1700, ms(28))
        >> (dc(400) | dc(0.7)) >> highpass()
        >> mul(n.velocity) >> dcblock() >> pan(-0.25)
  end,
}

-- A bar of metal is inharmonic; that is the only difference between this and
-- the cowbell.
bell = voice {
  params = { ring = { 0.1, 8.0, 2.6, "s" } },
  graph = function(n)
    local partials = { 1.0, 2.76, 5.40, 8.93, 13.34 }
    local modes = {}
    for i, r in ipairs(partials) do
      modes[i] = ring(n.hz * r, n.ring / i) * (1.0 / i)
    end
    return impulse() >> mix(modes) >> mul(n.velocity * 0.4) >> dcblock() >> pan(n.pan)
  end,
}

-- The membrane version: a low mode plus a pitch envelope, still struck.
tom = voice {
  params = { ring = { 0.05, 1.5, 0.34, "s" }, bend = { 0, 2, 0.7 } },
  graph = function(n)
    local swept = n.hz * (1 + n.bend * decay(ms(45)))
    return impulse() >> ring(swept, n.ring)
        >> shape("tanh", 1.2) >> mul(n.velocity) >> dcblock() >> pan(n.pan)
  end,
}

-- Noise into a bank of rings is a cymbal; the excitation is the only change.
cymbal = voice {
  graph = function(n)
    local wash = {}
    for i, hz in ipairs({ 2810, 3730, 4520, 5890, 7200, 9430 }) do
      wash[i] = ring(hz, secs(1.6)) * 0.2
    end
    return noise() * decay(ms(4)) >> mix(wash)
        >> mul(n.velocity) >> dcblock() >> pan(n.pan) >> to(room, 0.5)
  end,
}

---------------------------------------------------------------------- score

play(rim,     "x(5,8)"      >> velocity("0.9 0.5 0.6 0.5"))
play(cowbell, "~ x ~ ~ x ~ ~ ~" >> cowbell.ring("0.18 0.3") >> pan("-0.2 0.3"))
play(tom,     "~ ~ [g2 ~] ~" >> every(4, fast(2)) >> pan("0.3 -0.3"))
play(cymbal,  "x" >> slow(4) >> velocity(0.5))

play(bell, "<c5 g4 d#5 a#4>"
      >> slow(2)
      >> degrade(0.4)
      >> bell.ring(scale(1.4, 4.0, perlin(0.05)))
      >> velocity(0.35)
      >> pan("-0.4 0.4"))

master(limiter(0.004, 0.2) >> mul(0.8))
