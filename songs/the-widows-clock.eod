-- the-widows-clock.eod — The Widow's Clock
-- Original gothic chamber miniature: a violin lament in an abandoned ballroom.
-- D harmonic minor, 48 measures of 3/4 (36 engine cycles), roughly 100 seconds.
-- 0–8: solitary bow and cello; 8–24: a crooked waltz; 24–36: the hunt;
-- 36–44: the lament returns; 44–48: the clock stops. All synthesis, no samples.
-- Render: cargo run --release -p apteronotus-render -- --song the-widows-clock --cycles 36 --tail 7

tempo {
  {at=bars(0), bpm=84},
  {at=bars(18), bpm=116, over=bars(1.5)},
  {at=bars(27), bpm=84, over=bars(1.5)},
  {at=bars(33), bpm=60, over=bars(2.25)},
}
local expression = control {name="Violin expression", range={0, 1.4}, default=1}
local hall = send {
  graph = reverb(32, secs(3.8), .68) >> highpass(160) >> lowpass(5200),
  level = .26,
}

local violin = voice {
  params = {pressure={0, 1, .65}},
  graph = function(n)
    return bowed_string(n.hz, {pressure=n.pressure, vibrato=14, bow=.014})
      * n.velocity * .72 * slew(expression, .025) >> pan(-.18)
  end,
}
local second = voice {graph=function(n)
  return bowed_string(n.hz, {vibrato=8, brightness=.48, bow=.011,
    attack=ms(110)}) * n.velocity * .36 >> pan(.34)
end}
local viola = voice {graph=function(n)
  return bowed_string(n.hz, {kind="viola", vibrato=6, brightness=.42, bow=.012})
    * n.velocity * .37 >> pan(.18)
end}
local cello = voice {graph=function(n)
  return bowed_string(n.hz, {kind="cello", vibrato=7, brightness=.38, bow=.009})
    * n.velocity * .62 >> pan(.06)
end}
local pizz = voice {graph=function(n)
  local excitation = noise() * decay(ms(4))
  return excitation >> pluck(n.hz, .12, .55) >> lowpass(3400)
    >> mul(adsr(ms(2), ms(180), .25, ms(90)) * n.velocity * .7)
    >> pan(.25)
end}
local clock = voice {graph=function(n)
  return (sine(1450) * decay(ms(8)) + (noise() >> highpass(3200)) * decay(ms(4)) * .18)
    * (1 - decay(ms(.6))) * n.velocity * .12 >> pan(n.pan)
end}
local bell = voice {graph=function(n)
  local tone = sine(n.hz) * decay(secs(2.8))
    + sine(n.hz * 2.76) * decay(secs(1.1)) * .3
    + sine(n.hz * 5.41) * decay(ms(420)) * .12
  return tone * (1 - decay(ms(4))) * n.velocity * .09 >> pan(-.38)
end}

-- Pattern literals stay patterns in these tables, preserving editor spans.
local lament = {
  pattern("a4@2 d5"), pattern("f5@2 e5"),
  pattern("d5@2 c#5"), pattern("e5@2 a4"),
  pattern("bb4 a4 g4"), pattern("f4@2 e4"),
  pattern("e4 f4 c#5"), pattern("d5@2 ~"),
}
local waltz = {
  pattern("d5 a4 f5"), pattern("e5@2 d5"),
  pattern("f5 e5 d5"), pattern("c#5@2 a4"),
  pattern("bb4 d5 g5"), pattern("f5@2 e5"),
  pattern("e5 c#5 bb4"), pattern("a4@2 ~"),
  pattern("a5 g5 f5"), pattern("e5 f5 d5"),
  pattern("bb4 a4 g4"), pattern("c#5@2 e5"),
  pattern("d5 e5 f5"), pattern("g5@2 bb5"),
  pattern("a5 g5 c#5"), pattern("d5@2 ~"),
}
local hunt = {
  pattern("d5 e5 f5 a5 g5 f5"), pattern("e5 f5 d5 c#5 bb4 a4"),
  pattern("bb4 d5 f5 e5 d5 bb4"), pattern("a4 c#5 e5 g5 f5 e5"),
  pattern("g5 a5 bb5 a5 g5 d5"), pattern("f5 g5 a5 g5 f5 d5"),
  pattern("e5 f5 e5 d5 c#5 bb4"), pattern("a4 bb4 c#5 e5 g5 a5"),
  pattern("d6 a5 f5 e5 d5 a4"), pattern("bb5 a5 g5 f5 e5 d5"),
  pattern("c#5 e5 g5 bb5 a5 c#6"), pattern("d6@2 a5 f5 e5 c#5"),
}
local basses = {pattern("d3"), pattern("d3"), pattern("bb2"), pattern("a2"),
  pattern("g2"), pattern("d3"), pattern("a2"), pattern("d3")}
local inner = {pattern("[f4,a4]"), pattern("[e4,a4]"),
  pattern("[d4,f4]"), pattern("[c#4,e4]"),
  pattern("[bb3,d4]"), pattern("[a3,d4]"),
  pattern("[c#4,g4]"), pattern("[d4,f4]")}
local counterline = {pattern("f4"), pattern("e4"), pattern("d4"), pattern("c#4"),
  pattern("bb3"), pattern("a3"), pattern("c#4"), pattern("d4")}
local ostinati = {
  pattern("d4 a4 f4 a4 d4 a4"), pattern("d4 a4 e4 a4 d4 a4"),
  pattern("bb3 f4 d4 f4 bb3 f4"), pattern("a3 e4 c#4 e4 a3 e4"),
  pattern("g3 d4 bb3 d4 g3 d4"), pattern("d4 a4 f4 a4 d4 a4"),
  pattern("a3 e4 c#4 e4 g4 e4"), pattern("d4 a4 f4 a4 d4 a4"),
}
local leads, answers, middles, lows, picks, ticks, tolls = {}, {}, {}, {}, {}, {}, {}
local function measure(index, notes)
  return at(bars(index * .75), notes >> slow(.75), bars(.75))
end

for m = 0, 43 do
  local row = m % 8 + 1
  local hunting = m >= 24 and m < 36
  local returning = m >= 36
  local melody, strength
  if m < 8 then melody=lament[row]; strength=.68
  elseif m < 24 then melody=waltz[(m-8)%16+1]; strength=.79
  elseif hunting then melody=hunt[m-23]; strength=.94
  else melody=lament[(m-36)%8+1]; strength=.62 end
  table.insert(leads, measure(m, melody >> velocity(strength)
    >> violin.pressure(hunting and .95 or .6)))
  -- Long, dark bass bows; shorter repeated bows once the dance turns violent.
  if hunting then
    table.insert(lows, measure(m, basses[row] >> fast(3)
      >> hold(beats(.72)) >> velocity(.85)))
  else
    table.insert(lows, measure(m, basses[row]
      >> hold(beats(2.7)) >> velocity(returning and .44 or .65)))
  end
  if m >= 8 and not returning then
    -- Offbeat double stops make the 3/4 sway audible without a drum kit.
    table.insert(middles, at(bars(m*.75+.25), inner[row] >> fast(2)
      >> slow(.5) >> hold(beats(.72)) >> velocity(hunting and .64 or .52), bars(.5)))
    table.insert(picks, measure(m, ostinati[row]
      >> hold(beats(hunting and .3 or .38)) >> velocity(hunting and .64 or .55)))
  elseif m >= 4 and m % 2 == 0 then
    table.insert(middles, measure(m, inner[row]
      >> hold(beats(5.5)) >> velocity(.32)))
  end
  if (m >= 16 and m < 36) or (returning and m % 2 == 0) then
    table.insert(answers, measure(m, counterline[row]
      >> hold(beats(2.5)) >> velocity(hunting and .65 or .4)))
  end
  if m >= 8 and m < 36 then
    table.insert(ticks, measure(m, pattern("x x x")
      >> velocity(".65 .36 .45") >> pan("-.5 .45 -.35")))
  end
end
for _, m in ipairs({0, 8, 24, 36}) do
  table.insert(tolls, measure(m, pattern("d3") >> velocity(m==24 and .7 or .45)))
end
-- A suspended ninth, the raised leading note, then a bare fifth. No loop reset.
table.insert(leads, measure(44, pattern("e5@2 d5") >> velocity(.52)))
table.insert(leads, measure(45, pattern("c#5@2 a4") >> velocity(.45)))
-- measure() scales the whole phrase by 3/4, including holds. Undo that scale
-- for these final two-measure bows, so release lands near the written ending.
table.insert(leads, measure(46, pattern("d5") >> hold(beats(5.2/.75)) >> velocity(.4)))
table.insert(lows, measure(44, pattern("a2") >> hold(beats(5.6/.75)) >> velocity(.4)))
table.insert(lows, measure(46, pattern("d3") >> hold(beats(5.3/.75)) >> velocity(.36)))
table.insert(answers, measure(46, pattern("a4") >> hold(beats(4.8/.75)) >> velocity(.24)))
play(violin, timeline(leads) >> to(hall, .65))
play(second, timeline(answers) >> to(hall, .7))
play(viola, timeline(middles) >> to(hall, .55))
play(cello, timeline(lows) >> to(hall, .4))
play(pizz, timeline(picks) >> to(hall, .28))
play(clock, timeline(ticks) >> to(hall, .1))
play(bell, timeline(tolls) >> to(hall, .85))
master(highpass(38) >> lowpass(8500) >> limiter(ms(5), ms(180)) >> mul(.94))
